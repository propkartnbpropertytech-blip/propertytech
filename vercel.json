{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "if [ -d \"flutter\" ]; then cd flutter && git pull && cd ..; else git clone --depth 1 -b stable https://github.com/flutter/flutter.git; fi && flutter/bin/flutter config --enable-web",
  "buildCommand": "flutter/bin/flutter build web --release",
  "outputDirectory": "build/web",
  "rewrites": [
    {
      "source": "/api/share-preview",
      "destination": "/api/share-preview"
    },
    {
      "source": "/share/:sessionId/property/:propertyId",
      "destination": "/api/share-preview?sessionId=:sessionId&propertyId=:propertyId"
    },
    {
      "source": "/share/:sessionId",
      "destination": "/api/share-preview?sessionId=:sessionId"
    },
    {
      "source": "/api/:path*",
      "destination": "https://prop-kart-backend.vercel.app/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
