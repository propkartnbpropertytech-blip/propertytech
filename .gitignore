# Miscellaneous
node_modules/
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# Secrets and Credentials
.env*
!env/
!env/*.example
!env/local.env
!env/production.env
*creds*
*secret*
*.txt
!README.md
!CMakeLists.txt

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Release signing (never commit keystores or passwords)
/android/key.properties
**/*.jks
**/*.keystore

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Android build artifacts
/android/build/
/android/app/build/

# Platform ephemeral build artifacts
**/ephemeral/
**/windows/flutter/ephemeral/
**/linux/flutter/ephemeral/
**/macos/Flutter/ephemeral/
**/ios/Flutter/ephemeral/

# Local version snapshots
/Versions/
.sentry-native/
